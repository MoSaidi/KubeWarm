# See NOTICE for licensing; README.md documents the implementation.
FROM golang:1.24.7-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY cmd/worker ./cmd/worker
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/kubewarm-worker ./cmd/worker

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/kubewarm-worker /kubewarm-worker
ENTRYPOINT ["/kubewarm-worker"]
